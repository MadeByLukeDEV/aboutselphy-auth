# Shared Postgres instance in the AboutSelphy Dokploy namespace. URL-encode
# special characters in the password.
DATABASE_URL="postgres://user:password@host:5432/aboutselphy"
# Postgres schema holding this service's tables (created by `pnpm db:migrate`).
# When migrating the Discord bot dashboard, point this at the schema its
# embedded BetterAuth instance already uses so existing sessions stay valid.
DATABASE_SCHEMA="auth"

# BetterAuth. The secret signs the session cookie -- every consuming app that
# validates sessions needs the SAME value (and the dashboard's current secret
# must be reused here, or existing sessions are invalidated).
BETTER_AUTH_SECRET="generate-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Session cookie. Leave COOKIE_DOMAIN unset in dev (host-only cookie on
# localhost); set to aboutselphy.com in production so every *.aboutselphy.com
# subdomain can read it. Keep COOKIE_PREFIX identical to the dashboard's
# current value (BetterAuth default: better-auth).
COOKIE_DOMAIN=""
COOKIE_PREFIX="better-auth"

# Origins allowed as post-login redirect targets (comma separated, wildcards ok).
TRUSTED_ORIGINS="https://aboutselphy.com,https://*.aboutselphy.com"
# Where to send users after login when no ?redirect= was given.
DEFAULT_REDIRECT_URL="http://localhost:3000"

# Discord OAuth app. Redirect URI to register in the Discord developer portal:
#   ${BETTER_AUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Discord server whose roles gate access, and the role IDs mapping to each
# access level (comma separated). Admin wins if a member has both.
DISCORD_GUILD_ID=""
DISCORD_ADMIN_ROLE_IDS=""
DISCORD_MODERATOR_ROLE_IDS=""

# Twitch login (viewers). Leave empty to show Twitch as "Soon".
# dev.twitch.tv/console -> Register Your Application, OAuth Redirect URL:
#   ${BETTER_AUTH_URL}/api/auth/callback/twitch   (category: Website Integration)
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# YouTube login (viewers) = Google OAuth with the youtube.readonly scope.
# Leave empty to show YouTube as "Soon". Google Cloud console:
#   1. APIs & Services -> Library -> enable "YouTube Data API v3"
#   2. OAuth consent screen: add scope .../auth/youtube.readonly
#   3. Credentials -> OAuth client ID (Web application), redirect URI:
#      ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
